{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bobby-pocket-arcade",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "arcade.limaraya.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
