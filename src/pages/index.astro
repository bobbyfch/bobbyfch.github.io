const releases = [
  {
    number: "01",
    title: "Spektrum Rasa",
    detail: "Album pertama · 2025",
    image: "/albums/spektrum-rasa.jpg",
    story: "Catatan baca dari urutan judul: sebuah rasa lebih dulu diakui lewat Ada, belajar Legawa saat Saturasi datang, lalu mencari ruang di bawah Satu Atap Langit. Kolibri dan Tarian Terakhir membawa cerita ke perpisahan; Tetap Aku, Sarah, dan Terima Kasih menata ulang kedekatan sebelum Harmoni Semesta berakhir di ruang Antara. Ini tafsir editorial dari judul lagu, bukan sinopsis resmi.",
    storyEn: "A title-led reading: a feeling is first named in Ada, learns to let go in Legawa as Saturasi arrives, then searches for space beneath Satu Atap Langit. Kolibri and Tarian Terakhir carry the story toward parting; Tetap Aku, Sarah, and Terima Kasih reshape closeness before Harmoni Semesta settles in Antara. This is an editorial reading of the song titles, not an official synopsis.",
    tracks: ["Ada", "Legawa", "Saturasi", "Satu Atap Langit", "Kolibri", "Tarian Terakhir", "Tetap Aku", "Sarah", "Terima Kasih", "Harmoni Semesta", "Antara"],
    links: [
      { name: "Spotify", href: "https://open.spotify.com/album/6klR0U5CBaWT7oXIN2z9OH", icon: "/brand-icons/spotify.png" },
      { name: "Apple Music", href: "https://music.apple.com/id/album/spektrum-rasa/6809280279", icon: "/brand-icons/apple-music.png" },
      { name: "Audiomack", href: "https://audiomack.com/limaraya/album/spektrum-rasa-2", icon: "/brand-icons/audiomack.png" },
      { name: "TIDAL", href: "https://tidal.com/album/559190896", icon: "/brand-icons/tidal.png" },
