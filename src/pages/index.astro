---
import "../styles/global.css";
import { ArrowDownRight, ArrowUpRight, AtSign, Briefcase, Camera, CodeXml, Disc3, Gamepad2, Moon, Palette, Play, Sparkles, Sun } from "@lucide/astro";

const streaming = [
  { name: "Spotify", href: "https://open.spotify.com/artist/0gTusXkU2Q2M0vKTy4LU6a", note: "Ikuti perjalanan musik", icon: "/brand-icons/spotify.png" },
  { name: "Apple Music", href: "https://music.apple.com/id/artist/limaraya/1821338917", note: "Dengar katalog kami", icon: "/brand-icons/apple-music.png" },
  { name: "YouTube", href: "https://youtube.com/channel/UCZwduh5OJja1ShPWJ2KEcjA", note: "Tonton dan berlangganan", icon: "/brand-icons/youtube.png" },
  { name: "YouTube Music", href: "https://music.youtube.com/channel/UCZwduh5OJja1ShPWJ2KEcjA", note: "Dengar di YouTube Music", icon: "/brand-icons/youtube-music.png" },
  { name: "Audiomack", href: "https://audiomack.com/limaraya", note: "Putar rilisan Limaraya", icon: "/brand-icons/audiomack.png" },
  { name: "SoundCloud", href: "https://soundcloud.com/limaraya", note: "Dengar di SoundCloud", icon: "/brand-icons/soundcloud.png" },
  { name: "Amazon Music", href: "https://music.amazon.com/artists/B0FDJ1XBQ2/limaraya", note: "Temukan album dan lagu", icon: "/brand-icons/amazon-music.png" },
];

const releases = [
  {
    number: "01",
    title: "Spektrum Rasa",
    detail: "Album pertama · 2025",
    image: "/albums/spektrum-rasa.jpg",
    links: [
      { name: "Spotify", href: "https://open.spotify.com/album/6klR0U5CBaWT7oXIN2z9OH", icon: "/brand-icons/spotify.png" },
      { name: "Apple Music", href: "https://music.apple.com/id/album/spektrum-rasa/6809280279", icon: "/brand-icons/apple-music.png" },
      { name: "Audiomack", href: "https://audiomack.com/limaraya/album/spektrum-rasa-2", icon: "/brand-icons/audiomack.png" },
      { name: "TIDAL", href: "https://tidal.com/album/559190896", icon: "/brand-icons/tidal.png" },
      { name: "Amazon Music", href: "https://music.amazon.com/albums/B0HJ5PYWK1", icon: "/brand-icons/amazon-music.png" },
    ],
    embeds: [
      { name: "Spotify", src: "https://open.spotify.com/embed/album/6klR0U5CBaWT7oXIN2z9OH?utm_source=generator", height: 352, icon: "/brand-icons/spotify.png" },
      { name: "Apple Music", src: "https://embed.music.apple.com/id/album/spektrum-rasa/6809280279", height: 450, icon: "/brand-icons/apple-music.png" },
      { name: "Audiomack", src: "https://audiomack.com/embed/album/limaraya/spektrum-rasa-2", height: 400, icon: "/brand-icons/audiomack.png" },
      { name: "TIDAL", src: "https://embed.tidal.com/albums/559190896?layout=gridify", height: 275, icon: "/brand-icons/tidal.png" },
    ],
  },
  {
    number: "02",
    title: "Anahata",
    detail: "Album kedua · 2026",
    image: "/albums/anahata.jpg",
    links: [
      { name: "Spotify", href: "https://open.spotify.com/album/6NLGRRITjG1iuZdxcnC3Ea", icon: "/brand-icons/spotify.png" },
      { name: "Apple Music", href: "https://music.apple.com/id/album/anahata/6766773389", icon: "/brand-icons/apple-music.png" },
      { name: "Audiomack", href: "https://audiomack.com/limaraya/album/anahata", icon: "/brand-icons/audiomack.png" },
      { name: "TIDAL", href: "https://tidal.com/album/521540384", icon: "/brand-icons/tidal.png" },
      { name: "Amazon Music", href: "https://music.amazon.com/albums/B0GZHZB464", icon: "/brand-icons/amazon-music.png" },
    ],
    embeds: [
      { name: "Spotify", src: "https://open.spotify.com/embed/album/6NLGRRITjG1iuZdxcnC3Ea?utm_source=generator", height: 352, icon: "/brand-icons/spotify.png" },
      { name: "Apple Music", src: "https://embed.music.apple.com/id/album/anahata/6766773389", height: 450, icon: "/brand-icons/apple-music.png" },
      { name: "Audiomack", src: "https://audiomack.com/embed/album/limaraya/anahata", height: 400, icon: "/brand-icons/audiomack.png" },
      { name: "TIDAL", src: "https://embed.tidal.com/albums/521540384?layout=gridify", height: 275, icon: "/brand-icons/tidal.png" },
    ],
  },
];

const socials = [
  { name: "Instagram", href: "https://instagram.com/limarayamusic", icon: "/brand-icons/instagram.webp" },
  { name: "TikTok", href: "https://tiktok.com/@limarayamusic", icon: "/brand-icons/tiktok.png" },
  { name: "Threads", href: "https://www.threads.com/@limarayamusic", icon: "/brand-icons/threads.ico" },
  { name: "Facebook", href: "https://www.facebook.com/limarayamusic", icon: "/brand-icons/facebook.ico" },
];

const personalSocials = [
  { name: "GitHub", href: "https://github.com/bobbyfch", mark: "GH", note: "Proyek dan kode" },
  { name: "Instagram", href: "https://www.instagram.com/bobbyfch/", mark: "IG", note: "Foto dan keseharian" },
  { name: "Threads", href: "https://www.threads.com/@bobby.fch", mark: "TH", note: "Catatan dan percakapan" },
  { name: "LinkedIn", href: "https://id.linkedin.com/in/bobbyfajarc", mark: "in", note: "Profil profesional" },
];

const morePlayers = [
  {
    name: "YouTube",
    href: "https://youtube.com/channel/UCZwduh5OJja1ShPWJ2KEcjA",
    note: "Video dan rilisan di kanal resmi Limaraya.",
    src: "https://www.youtube-nocookie.com/embed/videoseries?list=UUZwduh5OJja1ShPWJ2KEcjA",
    height: 315,
    icon: "/brand-icons/youtube.png",
  },
  {
    name: "SoundCloud",
    href: "https://soundcloud.com/limaraya",
    note: "Koleksi suara Limaraya dari akun SoundCloud resmi.",
    src: "https://w.soundcloud.com/player/?visual=true&url=https%3A%2F%2Fapi.soundcloud.com%2Fusers%2F1569546207&show_artwork=true&maxheight=450",
    height: 450,
    icon: "/brand-icons/soundcloud.png",
  },
];
---

<!doctype html>
<html lang="id" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f7ff" />
    <meta name="description" content="Bobby Fajar Christian — web developer dari Jakarta yang suka game, musik, seni, dan teknologi. Pembuat Sela dan bagian dari Limaraya." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Bobby Fajar Christian — Karya, musik, dan hal yang kusukai" />
    <meta property="og:description" content="Web developer dari Jakarta. Membangun Sela, berkarya bersama Limaraya, dan menjelajahi game, seni, serta teknologi." />
    <meta property="og:url" content="https://bobbyfch.github.io/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/bobby.svg" />
    <link rel="canonical" href="https://bobbyfch.github.io/" />
    <title>Bobby Fajar Christian — Karya, musik, dan teknologi</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("bobby-theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme = stored || (prefersDark ? "dark" : "light");
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--page)] text-[var(--ink)] antialiased">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-[var(--paper)] focus:px-4 focus:py-3 focus:shadow-lg" href="#top">Lewati ke konten</a>
    <header class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-4 px-4 py-4 sm:px-6 sm:py-5 lg:px-8">
      <a class="inline-flex min-h-11 items-center gap-3 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]" href="#top" aria-label="Bobby Fajar Christian, ke bagian atas">
        <span class="grid size-10 place-items-center rounded-2xl bg-[var(--accent)] text-sm font-black tracking-tight text-[var(--accent-ink)] shadow-md shadow-blue-900/10">BF</span>
        <span class="text-sm font-extrabold tracking-tight sm:text-base">Bobby Fajar<span class="text-[var(--accent)]">.</span></span>
      </a>
      <nav class="order-3 flex w-full items-center justify-between gap-3 text-sm font-semibold sm:order-none sm:w-auto sm:justify-start sm:gap-6" aria-label="Navigasi utama">
        <a class="rounded-lg px-2 py-2 text-[var(--muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]" href="#karya">Karya</a>
        <a class="rounded-lg px-2 py-2 text-[var(--muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]" href="#limaraya">Limaraya</a>
        <a class="rounded-lg px-2 py-2 text-[var(--muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]" href="#tentang">Tentang</a>
        <a class="rounded-lg px-2 py-2 text-[var(--muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]" href="#sosial">Sosial</a>
      </nav>
      <button id="theme-toggle" class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--paper)] px-3.5 text-sm font-semibold transition hover:-translate-y-0.5 hover:border-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]" type="button" aria-pressed="false" aria-label="Ganti tema warna">
        <Sun class="size-4 dark:hidden" aria-hidden="true" />
        <Moon class="hidden size-4 dark:block" aria-hidden="true" />
        <span id="theme-label">Tema</span>
      </button>
    </header>

    <main id="top" class="mx-auto w-full max-w-7xl px-4 pb-16 sm:px-6 sm:pb-24 lg:px-8">
      <section id="tentang" class="grid scroll-mt-8 items-center gap-8 border-y border-[var(--line)] py-8 sm:gap-10 sm:py-12 md:grid-cols-[1fr_0.92fr] md:gap-8 lg:gap-14 lg:py-16" aria-labelledby="hero-title">
        <div class="relative z-10 py-2 sm:py-5">
          <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--paper)] px-3 py-1.5 text-xs font-bold tracking-wide text-[var(--muted)] shadow-sm">
            <span class="size-2 rounded-full bg-[var(--coral)]" aria-hidden="true"></span> JAKARTA, INDONESIA
          </p>
          <h1 id="hero-title" class="max-w-3xl text-5xl font-black leading-[0.98] tracking-tighter sm:text-6xl lg:text-7xl xl:text-8xl">Halo, saya<br /><span class="text-[var(--accent)]">Bobby.</span></h1>
          <p class="mt-6 max-w-xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">Web developer yang suka game, musik, seni, dan teknologi. Sekarang membangun <strong class="font-bold text-[var(--ink)]">Sela</strong> dan berkarya bersama <strong class="font-bold text-[var(--ink)]">Limaraya</strong>.</p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[var(--accent)] px-5 text-sm font-bold text-[var(--accent-ink)] shadow-lg shadow-blue-900/15 transition hover:-translate-y-0.5 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--accent)]" href="https://bobbyfch.github.io/sela/">Buka Sela <ArrowUpRight class="size-4" aria-hidden="true" /></a>
            <a class="inline-flex min-h-12 items-center gap-2 rounded-xl px-4 text-sm font-bold text-[var(--muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--accent)]" href="#karya">Lihat karya <ArrowDownRight class="size-4" aria-hidden="true" /></a>
          </div>
          <div class="mt-8 flex flex-wrap gap-2 text-xs font-semibold text-[var(--muted)] sm:mt-10">
            <span class="rounded-full bg-[var(--paper-soft)] px-3 py-1.5">Membangun hal berguna</span>
            <span class="rounded-full bg-[var(--paper-soft)] px-3 py-1.5">Mendengar banyak musik</span>
            <span class="rounded-full bg-[var(--paper-soft)] px-3 py-1.5">Selalu penasaran</span>
          </div>
        </div>
        <figure class="relative isolate m-0 min-w-0 overflow-hidden rounded-3xl border border-[var(--line)] bg-[var(--paper-soft)] shadow-xl">
          <img class="block aspect-auto min-h-72 w-full object-cover sm:min-h-80 md:aspect-square md:min-h-0 object-[67%_center] " src="/art/jakarta-reading-corner.webp" alt="Ilustrasi suasana membaca ceria di Jakarta dengan karakter dan teman hewan bergaya anime" width="2172" height="724" fetchpriority="high" />
          <figcaption class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 bg-gradient-to-t from-slate-950/70 to-transparent px-5 pb-5 pt-16 text-white sm:px-6 sm:pb-6">
            <span class="text-xs font-bold tracking-widest">JAKARTA <span class="text-cyan-200">/</span> CERITA &amp; BACAAN</span>
            <span class="grid size-10 shrink-0 place-items-center rounded-2xl border border-white/30 bg-white/15 backdrop-blur"><Sparkles class="size-5" aria-hidden="true" /></span>
          </figcaption>
          <span class="absolute right-4 top-4 rounded-full border border-white/50 bg-white/85 px-3 py-1.5 text-xs font-bold text-slate-800 shadow-sm backdrop-blur dark:border-white/20 dark:bg-slate-900/75 dark:text-white">Gambar dari sudut baca</span>
        </figure>
      </section>

      <section class="py-10 sm:py-14" aria-labelledby="interests-title">
        <div class="mb-4 flex items-end justify-between gap-4">
          <div><p class="mb-2 text-xs font-bold uppercase tracking-widest text-[var(--muted)]">Di luar layar kerja</p><h2 id="interests-title" class="text-xl font-extrabold tracking-tight sm:text-2xl">Hal yang sering kubuka</h2></div>
          <span class="hidden rounded-full bg-[var(--paper-soft)] px-3 py-1.5 text-xs font-semibold text-[var(--muted)] sm:inline-flex">sedikit dari banyak hal</span>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
          <div class="flex min-h-20 items-center gap-3 rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-3 sm:min-h-24 sm:p-4"><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-indigo-100 text-indigo-700 dark:bg-indigo-300/15 dark:text-indigo-200"><Gamepad2 class="size-5" aria-hidden="true" /></span><span class="min-w-0"><strong class="block text-sm font-bold">Game</strong><small class="mt-1 block text-xs text-[var(--muted)]">Main &amp; mengamati desain</small></span></div>
          <div class="flex min-h-20 items-center gap-3 rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-3 sm:min-h-24 sm:p-4"><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-rose-100 text-rose-700 dark:bg-rose-300/15 dark:text-rose-200"><Disc3 class="size-5" aria-hidden="true" /></span><span class="min-w-0"><strong class="block text-sm font-bold">Musik</strong><small class="mt-1 block text-xs text-[var(--muted)]">Dari lagu ke cerita</small></span></div>
          <div class="flex min-h-20 items-center gap-3 rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-3 sm:min-h-24 sm:p-4"><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-amber-100 text-amber-700 dark:bg-amber-300/15 dark:text-amber-200"><Palette class="size-5" aria-hidden="true" /></span><span class="min-w-0"><strong class="block text-sm font-bold">Seni visual</strong><small class="mt-1 block text-xs text-[var(--muted)]">Ilustrasi &amp; karya</small></span></div>
          <div class="flex min-h-20 items-center gap-3 rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-3 sm:min-h-24 sm:p-4"><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-emerald-100 text-emerald-700 dark:bg-emerald-300/15 dark:text-emerald-200"><Sparkles class="size-5" aria-hidden="true" /></span><span class="min-w-0"><strong class="block text-sm font-bold">Teknologi</strong><small class="mt-1 block text-xs text-[var(--muted)]">Termasuk AI</small></span></div>
        </div>
      </section>

      <section id="karya" class="scroll-mt-8 py-10 sm:py-14" aria-labelledby="work-title">
        <div class="mb-5 flex items-end justify-between gap-4 sm:mb-7">
          <div><p class="mb-2 text-xs font-bold uppercase tracking-widest text-[var(--muted)]">Dibuat dengan rasa ingin tahu</p><h2 id="work-title" class="text-2xl font-extrabold tracking-tight sm:text-3xl">Yang sedang kubangun</h2></div>
          <span class="hidden rounded-full border border-[var(--line)] px-3 py-1.5 text-xs font-bold text-[var(--muted)] sm:inline-flex">01—02</span>
        </div>
        <div class="grid gap-4 md:grid-cols-2 md:gap-5">
          <article class="group flex min-h-72 flex-col justify-between overflow-hidden rounded-3xl border border-indigo-200 bg-indigo-50 p-5 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-indigo-950/10 dark:border-indigo-300/20 dark:bg-indigo-300/[0.08] sm:min-h-80 sm:p-7">
            <div class="flex items-start justify-between gap-4">
              <span class="rounded-full bg-white/80 px-3 py-1.5 text-xs font-extrabold uppercase tracking-widest text-indigo-800 dark:bg-indigo-100/10 dark:text-indigo-100">Produk digital <span class="ml-1 text-indigo-400">/ 01</span></span>
              <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-900/20 transition group-hover:rotate-[-5deg] group-hover:scale-105 dark:bg-indigo-300 dark:text-indigo-950"><CodeXml class="size-7" aria-hidden="true" /></span>
            </div>
            <div class="mt-8">
              <h3 class="text-3xl font-black tracking-tight text-indigo-950 dark:text-indigo-50 sm:text-4xl">Sela</h3>
              <p class="mt-3 max-w-lg text-sm leading-6 text-indigo-950/75 dark:text-indigo-50/75 sm:text-base sm:leading-7">Pembaca buku pribadi untuk koleksi lokal, ruang baca yang nyaman, dan kendali tetap di tanganmu.</p>
            </div>
            <div class="mt-6 flex flex-wrap gap-2">
              <a class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-indigo-700 px-4 text-sm font-bold text-white transition hover:bg-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:bg-indigo-200 dark:text-indigo-950 dark:hover:bg-white" href="https://bobbyfch.github.io/sela/">Buka Sela <ArrowUpRight class="size-4" aria-hidden="true" /></a>
              <a class="inline-flex min-h-11 items-center gap-2 rounded-xl px-4 text-sm font-bold text-indigo-900 transition hover:bg-white/70 focus-visible:outline-2 focus-visible:outline-indigo-700 dark:text-indigo-100 dark:hover:bg-white/10" href="https://github.com/bobbyfch/sela" target="_blank" rel="noreferrer noopener">Lihat kode <ArrowUpRight class="size-4" aria-hidden="true" /></a>
            </div>
          </article>
          <article class="group flex min-h-72 flex-col justify-between overflow-hidden rounded-3xl border border-rose-200 bg-rose-50 p-5 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-950/10 dark:border-rose-300/20 dark:bg-rose-300/[0.08] sm:min-h-80 sm:p-7">
            <div class="flex items-start justify-between gap-4">
              <span class="rounded-full bg-white/80 px-3 py-1.5 text-xs font-extrabold uppercase tracking-widest text-rose-800 dark:bg-rose-100/10 dark:text-rose-100">Musik · Yogyakarta <span class="ml-1 text-rose-400">/ 02</span></span>
              <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-rose-500 text-white shadow-lg shadow-rose-900/20 transition group-hover:rotate-[5deg] group-hover:scale-105"><Disc3 class="size-7" aria-hidden="true" /></span>
            </div>
            <div class="mt-8">
              <h3 class="text-3xl font-black tracking-tight text-rose-950 dark:text-rose-50 sm:text-4xl">Limaraya</h3>
              <p class="mt-3 max-w-lg text-sm leading-6 text-rose-950/75 dark:text-rose-50/75 sm:text-base sm:leading-7">Proyek musik indie pop dan R&amp;B. Dua album, ruang untuk jeda, rasa, dan cerita.</p>
            </div>
            <a class="mt-6 inline-flex min-h-11 w-fit items-center gap-2 rounded-xl px-4 text-sm font-bold text-rose-900 transition hover:bg-white/70 focus-visible:outline-2 focus-visible:outline-rose-700 dark:text-rose-100 dark:hover:bg-white/10" href="#limaraya">Jelajahi Limaraya <ArrowDownRight class="size-4" aria-hidden="true" /></a>
          </article>
        </div>
      </section>

      <section id="sosial" class="scroll-mt-8 border-y border-[var(--line)] py-8 sm:py-10" aria-labelledby="personal-social-title">
        <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
          <div><p class="mb-2 text-xs font-bold uppercase tracking-widest text-[var(--muted)]">Temukan saya</p><h2 id="personal-social-title" class="text-2xl font-extrabold tracking-tight">Di internet</h2></div>
          <p class="text-sm text-[var(--muted)]">Pilih tempat yang paling nyaman.</p>
        </div>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
          {personalSocials.map((social) => (
            <a class="group flex min-h-16 min-w-0 items-center gap-3 rounded-2xl border border-transparent p-2 transition hover:border-[var(--line)] hover:bg-[var(--paper)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)] sm:min-h-20 sm:p-3" href={social.href} target="_blank" rel="noreferrer noopener" aria-label={`${social.name}: ${social.note}`}>
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-[var(--paper-soft)] text-[var(--accent)]"><span class="hidden">{social.mark}</span>{social.name === "GitHub" ? <CodeXml class="size-5" aria-hidden="true" /> : social.name === "Instagram" ? <Camera class="size-5" aria-hidden="true" /> : social.name === "Threads" ? <AtSign class="size-5" aria-hidden="true" /> : <Briefcase class="size-5" aria-hidden="true" />}</span>
              <span class="min-w-0 flex-1"><strong class="block truncate text-sm font-bold">{social.name}</strong><small class="mt-0.5 block truncate text-xs text-[var(--muted)]">{social.note}</small></span>
