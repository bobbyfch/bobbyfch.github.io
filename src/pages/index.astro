      { name: "TIDAL", src: "https://embed.tidal.com/albums/521540384?layout=gridify", height: 275, mark: "T" },
    ],
  },
  {
    title: "Spektrum Rasa",
    detail: "Album · 2025",
    image: "/albums/spektrum-rasa.jpg",
    links: [
      { name: "Spotify", href: "https://open.spotify.com/album/6klR0U5CBaWT7oXIN2z9OH", icon: "/vendor/webicons/webicon-spotify.svg" },
      { name: "Apple Music", href: "https://music.apple.com/id/album/spektrum-rasa/6809280279", icon: "/vendor/webicons/webicon-apple.svg" },
      { name: "Audiomack", href: "https://audiomack.com/limaraya/album/spektrum-rasa-2", mark: "AM" },
      { name: "TIDAL", href: "https://tidal.com/album/559190896", mark: "T" },
      { name: "Amazon Music", href: "https://music.amazon.com/albums/B0HJ5PYWK1", mark: "AMZ" },
    ],
    embeds: [
      { name: "Spotify", src: "https://open.spotify.com/embed/album/6klR0U5CBaWT7oXIN2z9OH?utm_source=generator", height: 352, icon: "/vendor/webicons/webicon-spotify.svg" },
      { name: "Apple Music", src: "https://embed.music.apple.com/id/album/spektrum-rasa/6809280279", height: 450, icon: "/vendor/webicons/webicon-apple.svg" },
      { name: "Audiomack", src: "https://audiomack.com/embed/album/limaraya/spektrum-rasa-2", height: 400, mark: "AM" },
      { name: "TIDAL", src: "https://embed.tidal.com/albums/559190896?layout=gridify", height: 275, mark: "T" },
    ],
  },
];

const socials = [
  { name: "Instagram", href: "https://instagram.com/limarayamusic", icon: "/vendor/webicons/webicon-instagram.svg" },
  { name: "TikTok", href: "https://tiktok.com/@limarayamusic", mark: "TK" },
  { name: "Threads", href: "https://www.threads.com/@limarayamusic", mark: "@" },
