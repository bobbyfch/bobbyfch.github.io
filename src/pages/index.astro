    ],
    embeds: [
      { name: "Spotify", src: "https://open.spotify.com/embed/album/6klR0U5CBaWT7oXIN2z9OH?utm_source=generator", height: 352, icon: "/brand-icons/spotify.png" },
      { name: "Apple Music", src: "https://embed.music.apple.com/id/album/spektrum-rasa/6809280279", height: 450, icon: "/brand-icons/apple-music.png" },
      { name: "Audiomack", src: "https://audiomack.com/embed/album/limaraya/spektrum-rasa-2", height: 400, icon: "/brand-icons/audiomack.png" },
      { name: "TIDAL", src: "https://embed.tidal.com/albums/559190896?layout=gridify", height: 275, icon: "/brand-icons/tidal.png" },
    ],
  },
  {
    number: "02",
    title: "Anahata",
    detail: "Album kedua · 2026",
    image: "/albums/anahata.jpg",
    story: "Catatan baca dari urutan judul: kilau Ki Ra Ki Ra membuka jalan pulang, melewati Rona, hydrangea, dan kemungkinan seumpama sebelum tersesat di astray. Komedi Putar, Ribuan Suara, dan Seperti Bahagia mengubah perjalanan menjadi riuh; Heart Cache, Tanpaku, Luruh, dan Distorsi menyisakan ruang untuk berdiam. Dari SOWAN, Doa Iblis, serta RIMBA LOKA, cerita bergerak melewati ruang tunggu, Sebentar Saja, Adegan Dewasa, april, MUARA, benang merah bintang-bintang, Aphelion, hingga hari-hari seperti ini. Ini pembacaan kreatif atas judul lagu, bukan narasi resmi band.",
    storyEn: "A title-led reading: the shimmer of Ki Ra Ki Ra opens a way back, passing through Rona, hydrangea, and the possibility of seumpama before getting astray. Komedi Putar, Ribuan Suara, and Seperti Bahagia turn the journey noisy; Heart Cache, Tanpaku, Luruh, and Distorsi leave room to sit with it. From SOWAN, Doa Iblis, and RIMBA LOKA, the story moves through ruang tunggu, Sebentar Saja, Adegan Dewasa, april, MUARA, a red thread across the stars, Aphelion, and hari-hari seperti ini. This is a creative reading of the titles, not the band’s official narrative.",
    tracks: ["Ki Ra Ki Ra", "came back to you", "Rona", "hydrangea", "seumpama", "astray", "Komedi Putar", "Ribuan Suara", "Seperti Bahagia", "Heart Cache", "Tanpaku", "Luruh", "slo—OW bu—URN", "Distorsi", "SOWAN", "Doa Iblis", "RIMBA LOKA", "ruang tunggu", "Sebentar Saja", "Adegan Dewasa", "april", "MUARA", "Red Thread Across the Sea of Stars (星海红线)", "Aphelion", "hari-hari seperti ini"],
    links: [
      { name: "Spotify", href: "https://open.spotify.com/album/6NLGRRITjG1iuZdxcnC3Ea", icon: "/brand-icons/spotify.png" },
      { name: "Apple Music", href: "https://music.apple.com/id/album/anahata/6766773389", icon: "/brand-icons/apple-music.png" },
      { name: "Audiomack", href: "https://audiomack.com/limaraya/album/anahata", icon: "/brand-icons/audiomack.png" },
      { name: "TIDAL", href: "https://tidal.com/album/521540384", icon: "/brand-icons/tidal.png" },
      { name: "Amazon Music", href: "https://music.amazon.com/albums/B0GZHZB464", icon: "/brand-icons/amazon-music.png" },
    ],
    embeds: [
      { name: "Spotify", src: "https://open.spotify.com/embed/album/6NLGRRITjG1iuZdxcnC3Ea?utm_source=generator", height: 352, icon: "/brand-icons/spotify.png" },
      { name: "Apple Music", src: "https://embed.music.apple.com/id/album/anahata/6766773389", height: 450, icon: "/brand-icons/apple-music.png" },
      { name: "Audiomack", src: "https://audiomack.com/embed/album/limaraya/anahata", height: 400, icon: "/brand-icons/audiomack.png" },
      { name: "TIDAL", src: "https://embed.tidal.com/albums/521540384?layout=gridify", height: 275, icon: "/brand-icons/tidal.png" },
    ],
  },
];

const socials = [
  { name: "Instagram", href: "https://instagram.com/limarayamusic", icon: "/brand-icons/instagram.webp" },
  { name: "TikTok", href: "https://tiktok.com/@limarayamusic", icon: "/brand-icons/tiktok.png" },
  { name: "Threads", href: "https://www.threads.com/@limarayamusic", icon: "/brand-icons/threads.ico" },
  { name: "Facebook", href: "https://www.facebook.com/limarayamusic", icon: "/brand-icons/facebook.ico" },
];

const personalSocials = [
  { name: "GitHub", href: "https://github.com/bobbyfch", mark: "GH", note: "Proyek dan kode" },
  { name: "Instagram", href: "https://www.instagram.com/bobbyfch/", mark: "IG", note: "Foto dan keseharian" },
  { name: "Threads", href: "https://www.threads.com/@bobby.fch", mark: "TH", note: "Catatan dan percakapan" },
  { name: "LinkedIn", href: "https://id.linkedin.com/in/bobbyfajarc", mark: "in", note: "Profil profesional" },
];

const personalSocialIcons: Partial<Record<(typeof personalSocials)[number]["name"], SimpleIcon>> = {
  GitHub: siGithub,
  Instagram: siInstagram,
  Threads: siThreads,
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://bobbyfch.github.io/#bobby",
      name: "Bobby Fajar Christian",
      url: "https://bobbyfch.github.io/",
      jobTitle: "Web developer and creative technologist",
      address: { "@type": "PostalAddress", addressLocality: "Jakarta", addressCountry: "ID" },
      sameAs: personalSocials.map(({ href }) => href),
    },
    {
      "@type": "WebSite",
      "@id": "https://bobbyfch.github.io/#website",
      name: "Bobby Fajar Christian · Limaraya",
      url: "https://bobbyfch.github.io/",
      publisher: { "@id": "https://bobbyfch.github.io/#bobby" },
      copyrightHolder: { "@id": "https://bobbyfch.github.io/#bobby" },
      inLanguage: ["id-ID", "en"],
    },
    {
      "@type": "MusicGroup",
      "@id": "https://bobbyfch.github.io/#limaraya",
      name: "Limaraya",
      genre: ["Indie pop", "R&B"],
      url: "https://bobbyfch.github.io/#limaraya",
      sameAs: ["https://open.spotify.com/artist/0gTusXkU2Q2M0vKTy4LU6a", "https://music.apple.com/id/artist/limaraya/1821338917"],
    },
    {
      "@type": "SoftwareApplication",
      name: "Sela Books",
      applicationCategory: "ReadingApplication",
      operatingSystem: "Web",
      url: "https://bobbyfch.github.io/sela/",
      creator: { "@id": "https://bobbyfch.github.io/#bobby" },
    },
  ],
};

const morePlayers = [
  {
    name: "YouTube",
    href: "https://youtube.com/channel/UCZwduh5OJja1ShPWJ2KEcjA",
    note: "Video dan rilisan di kanal resmi Limaraya.",
    src: "https://www.youtube-nocookie.com/embed/videoseries?list=UUZwduh5OJja1ShPWJ2KEcjA",
    height: 315,
    icon: "/brand-icons/youtube.png",
  },
  {
    name: "SoundCloud",
    href: "https://soundcloud.com/limaraya",
    note: "Koleksi suara Limaraya dari akun SoundCloud resmi.",
    src: "https://w.soundcloud.com/player/?visual=true&url=https%3A%2F%2Fapi.soundcloud.com%2Fusers%2F1569546207&show_artwork=true&maxheight=450",
    height: 450,
    icon: "/brand-icons/soundcloud.png",
  },
];
---

<!doctype html>
<html lang="id" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f7ff" />
    <meta name="author" content="Bobby Fajar Christian" />
    <meta name="description" content="Selamat datang di ruang kreatif Bobby Fajar Christian: karya digital, musik dan semesta cerita Limaraya, seni, game, serta teknologi dari Jakarta." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Limaraya · ruang kreatif Bobby Fajar Christian" />
    <meta property="og:description" content="Karya digital, musik, seni, game, teknologi, dan cerita Limaraya dari Jakarta." />
    <meta property="og:url" content="https://bobbyfch.github.io/" />
    <meta property="og:image" content="https://bobbyfch.github.io/art/jakarta-reading-corner.webp" />
    <meta property="og:image:alt" content="Ilustrasi ceria sudut baca Jakarta karya Bobby Fajar Christian" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Limaraya · ruang kreatif Bobby Fajar Christian" />
    <meta name="twitter:description" content="Karya digital, musik, seni, game, teknologi, dan cerita Limaraya dari Jakarta." />
    <meta name="twitter:image" content="https://bobbyfch.github.io/art/jakarta-reading-corner.webp" />
    <link rel="icon" type="image/svg+xml" href="/bobby.svg" />
    <link rel="canonical" href="https://bobbyfch.github.io/" />
    <title>Limaraya · ruang kreatif Bobby Fajar Christian</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <script>
      import "../scripts/site.ts";
    </script>
  </head>
  <body class="min-h-screen bg-[var(--page)] text-[var(--ink)] antialiased">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-[var(--paper)] focus:px-4 focus:py-3 focus:shadow-lg" href="#top">Lewati ke konten</a>
    <header class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-4 px-4 py-4 sm:px-6 sm:py-5 lg:px-8">
      <a class="inline-flex min-h-11 items-center gap-3 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]" href="#top" aria-label="Bobby Fajar Christian, ke bagian atas">
        <span class="grid size-10 place-items-center rounded-2xl bg-[var(--accent)] text-sm font-black tracking-tight text-[var(--accent-ink)] shadow-md shadow-blue-900/10">BF</span>
        <span class="text-sm font-extrabold tracking-tight sm:text-base">Bobby Fajar<span class="text-[var(--accent)]">.</span></span>
      </a>
      <nav class="order-3 flex w-full items-center justify-between gap-3 text-sm font-semibold sm:order-none sm:w-auto sm:justify-start sm:gap-6" aria-label="Navigasi utama">
        <a data-i18n="nav-work" class="rounded-lg px-2 py-2 text-[var(--muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]" href="#karya">Karya</a>
        <a data-i18n="nav-limaraya" class="rounded-lg px-2 py-2 text-[var(--muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]" href="#limaraya">Limaraya</a>
        <a data-i18n="nav-about" class="rounded-lg px-2 py-2 text-[var(--muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]" href="#tentang">Tentang</a>
        <a data-i18n="nav-social" class="rounded-lg px-2 py-2 text-[var(--muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-[var(--accent)]" href="#sosial">Sosial</a>
      </nav>
      <div class="flex shrink-0 items-center gap-2">
      <button id="language-toggle" class="grid size-10 place-items-center overflow-hidden rounded-full border border-[var(--line)] bg-[var(--paper)] text-lg transition hover:-translate-y-0.5 hover:border-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]" type="button" aria-label="Switch to English" title="Bahasa Indonesia" data-language-indicator>🇮🇩</button>
      <button id="theme-toggle" class="grid size-10 shrink-0 place-items-center rounded-full border border-[var(--line)] bg-[var(--paper)] transition hover:-translate-y-0.5 hover:border-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]" type="button" aria-pressed="false" aria-label="Ganti tema warna">
        <Sun class="size-4 dark:hidden" aria-hidden="true" />
        <Moon class="hidden size-4 dark:block" aria-hidden="true" />
      </button>
      </div>
    </header>

    <main id="top" class="mx-auto w-full max-w-7xl px-4 pb-16 sm:px-6 sm:pb-24 lg:px-8">
      <section id="tentang" class="grid scroll-mt-8 items-center gap-8 border-y border-[var(--line)] py-8 sm:gap-10 sm:py-12 md:grid-cols-[1fr_0.92fr] md:gap-8 lg:gap-14 lg:py-16" aria-labelledby="hero-title">
        <div class="relative z-10 py-2 sm:py-5">
          <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--paper)] px-3 py-1.5 text-xs font-bold tracking-wide text-[var(--muted)] shadow-sm">
            <span class="size-2 rounded-full bg-[var(--coral)]" aria-hidden="true"></span> JAKARTA, INDONESIA
          </p>
          <h1 id="hero-title" class="max-w-3xl text-5xl font-black leading-[0.98] tracking-tighter sm:text-6xl lg:text-7xl xl:text-8xl"><span data-i18n="hero-welcome">Selamat datang di</span><br /><span class="text-[var(--accent)]">Limaraya.</span></h1>
          <p data-i18n="hero-copy" class="mt-6 max-w-xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">Ruang kreatif Bobby Fajar Christian untuk karya digital, musik, seni, game, dan teknologi—rumah bagi Sela serta semesta cerita Limaraya.</p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a data-i18n="hero-sela" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[var(--accent)] px-5 text-sm font-bold text-[var(--accent-ink)] shadow-lg shadow-blue-900/15 transition hover:-translate-y-0.5 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--accent)]" href="https://bobbyfch.github.io/sela/">Buka Sela <ArrowUpRight class="size-4" aria-hidden="true" /></a>
            <a data-i18n="hero-work" class="inline-flex min-h-12 items-center gap-2 rounded-xl px-4 text-sm font-bold text-[var(--muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--accent)]" href="#karya">Lihat karya <ArrowDownRight class="size-4" aria-hidden="true" /></a>
          </div>
          <div class="mt-8 flex flex-wrap gap-2 text-xs font-semibold text-[var(--muted)] sm:mt-10">
            <span class="rounded-full bg-[var(--paper-soft)] px-3 py-1.5">Membangun hal berguna</span>
            <span class="rounded-full bg-[var(--paper-soft)] px-3 py-1.5">Mendengar banyak musik</span>
            <span class="rounded-full bg-[var(--paper-soft)] px-3 py-1.5">Selalu penasaran</span>
          </div>
        </div>
        <figure class="relative isolate m-0 min-w-0 overflow-hidden rounded-3xl border border-[var(--line)] bg-[var(--paper-soft)] shadow-xl">
          <img class="block aspect-auto min-h-72 w-full object-cover sm:min-h-80 md:aspect-square md:min-h-0 object-[67%_center] " src="/art/jakarta-reading-corner.webp" alt="Ilustrasi suasana membaca ceria di Jakarta dengan karakter dan teman hewan bergaya anime" width="2172" height="724" fetchpriority="high" />
          <figcaption class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 bg-gradient-to-t from-slate-950/70 to-transparent px-5 pb-5 pt-16 text-white sm:px-6 sm:pb-6">
            <span class="text-xs font-bold tracking-widest">JAKARTA <span class="text-cyan-200">/</span> CERITA &amp; BACAAN</span>
            <span class="grid size-10 shrink-0 place-items-center rounded-2xl border border-white/30 bg-white/15 backdrop-blur"><Sparkles class="size-5" aria-hidden="true" /></span>
          </figcaption>
          <span class="absolute right-4 top-4 rounded-full border border-white/50 bg-white/85 px-3 py-1.5 text-xs font-bold text-slate-800 shadow-sm backdrop-blur dark:border-white/20 dark:bg-slate-900/75 dark:text-white">Gambar dari sudut baca</span>
        </figure>
      </section>

      <section class="py-10 sm:py-14" aria-labelledby="interests-title">
        <div class="mb-4 flex items-end justify-between gap-4">
          <div><p class="mb-2 text-xs font-bold uppercase tracking-widest text-[var(--muted)]">Di luar layar kerja</p><h2 id="interests-title" class="text-xl font-extrabold tracking-tight sm:text-2xl">Hal yang sering kubuka</h2></div>
          <span class="hidden rounded-full bg-[var(--paper-soft)] px-3 py-1.5 text-xs font-semibold text-[var(--muted)] sm:inline-flex">sedikit dari banyak hal</span>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
          <div class="flex min-h-20 items-center gap-3 rounded-2xl border border-[var(--line)] bg-[color-mix(in_srgb,var(--paper)_76%,transparent)] p-3 shadow-sm backdrop-blur-xl transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:min-h-24 sm:p-4"><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-indigo-100 text-indigo-700 dark:bg-indigo-300/15 dark:text-indigo-200"><Gamepad2 class="size-5" aria-hidden="true" /></span><span class="min-w-0"><strong class="block text-sm font-bold">Game</strong><small class="mt-1 block text-xs text-[var(--muted)]">Main &amp; mengamati desain</small></span></div>
          <div class="flex min-h-20 items-center gap-3 rounded-2xl border border-[var(--line)] bg-[color-mix(in_srgb,var(--paper)_76%,transparent)] p-3 shadow-sm backdrop-blur-xl transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:min-h-24 sm:p-4"><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-rose-100 text-rose-700 dark:bg-rose-300/15 dark:text-rose-200"><Disc3 class="size-5" aria-hidden="true" /></span><span class="min-w-0"><strong class="block text-sm font-bold">Musik</strong><small class="mt-1 block text-xs text-[var(--muted)]">Dari lagu ke cerita</small></span></div>
          <div class="flex min-h-20 items-center gap-3 rounded-2xl border border-[var(--line)] bg-[color-mix(in_srgb,var(--paper)_76%,transparent)] p-3 shadow-sm backdrop-blur-xl transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:min-h-24 sm:p-4"><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-amber-100 text-amber-700 dark:bg-amber-300/15 dark:text-amber-200"><Palette class="size-5" aria-hidden="true" /></span><span class="min-w-0"><strong class="block text-sm font-bold">Seni visual</strong><small class="mt-1 block text-xs text-[var(--muted)]">Ilustrasi &amp; karya</small></span></div>
          <div class="flex min-h-20 items-center gap-3 rounded-2xl border border-[var(--line)] bg-[color-mix(in_srgb,var(--paper)_76%,transparent)] p-3 shadow-sm backdrop-blur-xl transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:min-h-24 sm:p-4"><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-emerald-100 text-emerald-700 dark:bg-emerald-300/15 dark:text-emerald-200"><Sparkles class="size-5" aria-hidden="true" /></span><span class="min-w-0"><strong class="block text-sm font-bold">Teknologi</strong><small class="mt-1 block text-xs text-[var(--muted)]">Termasuk AI</small></span></div>
        </div>
      </section>

      <section id="karya" class="scroll-mt-8 py-10 sm:py-14" aria-labelledby="work-title">
