---
import "../styles/global.css";
import { ArrowUpRight, Moon, Sun } from "@lucide/astro";
import { featuredAdventure, games } from "../games/catalog";
import { gameCoverArt } from "../games/cover-art";
import { socialLinks } from "../games/socials";

const firstGame = featuredAdventure;
const featuredGame = firstGame;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fff8ea" />
    <meta name="author" content="Bobby Fajar Christian" />
    <meta name="description" content="Play Bob’s Adventure across 25 levels inspired by Indonesia’s rice terraces, volcanoes, islands, rainforests, and highlands, plus 26 original arcade games." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Bob’s Adventure · Bobby Fajar Christian" />
    <meta property="og:description" content="Explore 25 Indonesian-inspired platforming levels, then choose from 26 original arcade games." />
    <meta property="og:url" content="https://bobbyfch.github.io/" />
    <meta property="og:site_name" content="Bobby Fajar Christian" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://bobbyfch.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Bob’s Adventure · Bobby Fajar Christian</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("bobby-space-theme");
        const systemTheme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = savedTheme === "dark" || savedTheme === "light" ? savedTheme : systemTheme;
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the main content</a>

    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="#main">Bobby Fajar Christian</a>
        <nav class="header-nav" aria-label="Main navigation">
          <a href="#arcade">ARCADE <span class="nav-count">26</span></a>
          <a href="#social">ELSEWHERE</a>
          <a class="header-nav-feature" href="https://limaraya.com/">LIMARAYA <ArrowUpRight aria-hidden="true" /></a>
        </nav>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
          <Sun class="theme-icon theme-icon--sun" aria-hidden="true" />
          <Moon class="theme-icon theme-icon--moon" aria-hidden="true" />
          <span class="sr-only">Toggle light or dark theme</span>
        </button>
      </header>

      <main id="main" class="main-content">
        <section class="hero" aria-labelledby="page-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> BOBBY FAJAR CHRISTIAN <span class="eyebrow-divider">/</span> PERSONAL ARCADE</p>
            <h1 id="page-title">Bob’s<br /><span>Adventure.</span></h1>
            <p class="intro-description">Run, jump, and find your way home through 25 Indonesian-inspired levels. Then take a quick break with 26 original arcade games.</p>
            <a class="limaraya-cta" href="https://limaraya.com/">
              <span class="cta-copy"><span class="cta-kicker">MUSIC, STORIES & OTHER THINGS I MAKE</span><span class="cta-title">Find me at Limaraya.com</span></span>
              <span class="cta-arrow"><ArrowUpRight aria-hidden="true" /></span>
            </a>
          </div>

          <article class="hero-feature" aria-label={`Featured game: ${featuredGame.name}`}>
            <div class="hero-feature-art" aria-hidden="true" set:html={gameCoverArt(featuredGame)}></div>
            <div class="hero-feature-caption">
              <div class="feature-copy">
                <span class="feature-kicker">FLAGSHIP PLATFORMER <span>25 LEVELS</span></span>
                <h2>Find the way home</h2>
              </div>
              <button class="feature-play" type="button" data-feature-game={featuredGame.id}>
                PLAY <ArrowUpRight aria-hidden="true" />
              </button>
            </div>
          </article>
        </section>

        <section id="social" class="social-section" aria-labelledby="social-title">
          <div class="social-heading">
            <p class="section-kicker">SAY HELLO</p>
            <h2 id="social-title">Elsewhere<span>.</span></h2>
          </div>
          <div class="social-links">
            {socialLinks.map((social) => (
              <a
                class="social-link"
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${social.name}, ${social.handle} (opens in a new tab)`}
              >
                <span class="social-icon" style={`--social-accent:${social.accent};`} aria-hidden="true">
                  {social.icon ? <svg viewBox="0 0 24 24" focusable="false"><path fill="currentColor" d={social.icon.path} /></svg> : <span>in</span>}
                </span>
                <span class="social-copy"><span class="social-name">{social.name}</span><span class="social-handle">{social.handle}</span></span>
                <ArrowUpRight class="social-arrow" aria-hidden="true" />
              </a>
            ))}
          </div>
        </section>

        <section id="arcade" class="arcade-section" aria-labelledby="arcade-title">
          <div class="section-heading">
            <div>
              <p class="section-kicker"><span class="section-mark" aria-hidden="true"></span> THE ARCADE <span>26 ORIGINAL GAMES</span></p>
              <h2 id="arcade-title">Pick your next game<span>.</span></h2>
            </div>
            <p class="section-intro">Built for short breaks. Stay for another round.</p>
          </div>

          <section id="game-player" class="game-player" aria-labelledby="selected-game-name">
            <div class="game-brief">
              <p class="panel-kicker"><span class="selection-led" aria-hidden="true"></span> ON THE SCREEN <span class="selection-index" id="arcade-status">LEVEL 01 / 25</span></p>
              <h3 id="selected-game-name">{firstGame.name}</h3>
              <p class="game-description" id="game-description">{firstGame.description}</p>
              <div class="game-instructions">
                <span class="instruction-label">CONTROLS</span>
                <p class="keyboard-hint" id="controls-copy">{firstGame.controls} · Press ENTER to start</p>
              </div>
            </div>

            <div class="arcade-stage" id="arcade-stage" data-game-id={firstGame.id} style={`--stage-bg:${firstGame.palette.background};`}>
              <div id="arcade-canvas" class="arcade-canvas" tabindex="0" role="img" aria-label="Pixel-art arcade playfield. Use the game controls below to play."></div>
              <div id="game-overlay" class="game-overlay" aria-live="polite">
                <span class="overlay-kicker" id="overlay-kicker">ORIGINAL GAME</span>
                <h4 id="overlay-title">{firstGame.name}</h4>
                <p id="overlay-message">{firstGame.description}</p>
                <button id="game-start" class="start-button" type="button"><span aria-hidden="true">▶</span> PLAY</button>
              </div>
            </div>

            <div class="game-bottom-row">
                <span class="arcade-note">NO DOWNLOAD NEEDED</span>
              <div class="touch-controls" role="group" aria-label="Arcade controls">
                <button type="button" data-action="left" aria-label="Move or turn left">←</button>
                <button type="button" data-action="up" aria-label="Jump">↑</button>
                <button type="button" data-action="action" aria-label="Jump"><span id="action-label">JUMP</span></button>
                <button type="button" data-action="down" aria-label="Drop through a platform">↓</button>
                <button type="button" data-action="right" aria-label="Move or turn right">→</button>
              </div>
            </div>
            <button id="first-turn-toggle" class="first-turn-toggle" type="button" hidden>YOU MOVE FIRST</button>
          </section>

          <div class="catalog-heading">
            <h3>All 26 games</h3>
            <p>Tap a cover to load it.</p>
          </div>

          <div class="game-picker" id="game-picker" role="group" aria-label="Choose from 26 original A-to-Z games">
            {games.map((game) => (
              <button class="game-choice" type="button" data-game-select={game.id} data-game-letter={game.letter} style={`--cover-bg:${game.palette.background};--cover-primary:${game.palette.primary};--cover-secondary:${game.palette.secondary};--cover-accent:${game.palette.accent};`} aria-label={`Play ${game.name}`} title={`${game.letter} · ${game.name}`} aria-pressed={game.id === firstGame.id ? "true" : "false"}>
                <span class="game-art" data-art={game.art} aria-hidden="true" set:html={gameCoverArt(game)}></span>
                <span class="game-choice-copy">
                  <span class="game-choice-meta"><span>{game.letter}</span><span>{game.kind}</span></span>
                  <span class="game-choice-name">{game.name}</span>
                </span>
              </button>
            ))}
          </div>
        </section>

        <footer class="page-footer">
          <a class="footer-name" href="#main">Bobby Fajar Christian</a>
          <span>© {new Date().getFullYear()} <span class="footer-separator">/</span> MADE BY BOBBY</span>
          <a class="footer-limaraya" href="https://limaraya.com/">VISIT LIMARAYA.COM <ArrowUpRight aria-hidden="true" /></a>
        </footer>
      </main>
    </div>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
