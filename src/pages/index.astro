---
import "../styles/global.css";

const streaming = [
  { name: "Spotify", href: "https://open.spotify.com/artist/0gTusXkU2Q2M0vKTy4LU6a", note: "Ikuti perjalanan musik", icon: "/vendor/webicons/webicon-spotify.svg" },
  { name: "Apple Music", href: "https://music.apple.com/id/artist/limaraya/1821338917", note: "Dengar katalog kami", icon: "/vendor/webicons/webicon-apple.svg" },
  { name: "YouTube", href: "https://youtube.com/channel/UCZwduh5OJja1ShPWJ2KEcjA", note: "Tonton dan berlangganan", icon: "/vendor/webicons/webicon-youtube.svg" },
  { name: "YouTube Music", href: "https://music.youtube.com/channel/UCZwduh5OJja1ShPWJ2KEcjA", note: "Dengar di YouTube Music", icon: "/vendor/webicons/webicon-youtube.svg" },
  { name: "Audiomack", href: "https://audiomack.com/limaraya", note: "Putar rilisan Limaraya", mark: "AM" },
  { name: "SoundCloud", href: "https://soundcloud.com/limaraya", note: "Dengar di SoundCloud", icon: "/vendor/webicons/webicon-soundcloud.svg" },
  { name: "Amazon Music", href: "https://music.amazon.com/artists/B0FDJ1XBQ2/limaraya", note: "Temukan album dan lagu", mark: "AMZ" },
];

const releases = [
  {
    title: "Anahata",
    detail: "Album · 2026",
    image: "/albums/anahata.jpg",
    links: [
      { name: "Spotify", href: "https://open.spotify.com/album/6NLGRRITjG1iuZdxcnC3Ea", icon: "/vendor/webicons/webicon-spotify.svg" },
      { name: "Apple Music", href: "https://music.apple.com/id/album/anahata/6766773389", icon: "/vendor/webicons/webicon-apple.svg" },
      { name: "Audiomack", href: "https://audiomack.com/limaraya/album/anahata", mark: "AM" },
      { name: "TIDAL", href: "https://tidal.com/album/521540384", mark: "T" },
      { name: "Amazon Music", href: "https://music.amazon.com/albums/B0GZHZB464", mark: "AMZ" },
    ],
    embeds: [
      { name: "Spotify", src: "https://open.spotify.com/embed/album/6NLGRRITjG1iuZdxcnC3Ea?utm_source=generator", height: 352, icon: "/vendor/webicons/webicon-spotify.svg" },
      { name: "Apple Music", src: "https://embed.music.apple.com/id/album/anahata/6766773389", height: 450, icon: "/vendor/webicons/webicon-apple.svg" },
